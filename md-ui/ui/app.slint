import { AboutSlint } from "std-widgets.slint";

// Ventana base de la que heredarán los menús, OSD y widgets de MinimalistDots.
// La v1 usa ventanas xdg-toplevel posicionadas con windowrules de Hyprland
// (ADR-0003). `accent` y `md-radius` permiten estilizar cada instancia.
export component MdWindow inherits Window {
    in property <color> accent: #7ec7a2;
    in property <length> md-radius: 10px;

    // Título y tamaño configurables desde Rust (alias de las props de Window).
    in-out property <string> md-title: "MinimalistDots";
    in-out property <length> md-width: 600px;
    in-out property <length> md-height: 400px;

    title <=> root.md-title;
    width <=> root.md-width;
    height <=> root.md-height;

    background: #1e222a;
}

// Diálogo "Acerca de". Usa AboutSlint: requisito de la licencia Royalty-free
// de Slint (ADR-0008).
export component AboutWindow inherits Window {
    title: "Acerca de MinimalistDots";
    width: 460px;
    height: 520px;

    AboutSlint { }
}

// Fila de un menú. `icon` es una imagen ya cargada por el anfitrión (un
// `slint::Image`); una imagen vacía (ancho 0) significa "sin icono".
export struct MenuItem {
    label: string,
    icon: image,
}

// Menú genérico reutilizable (lo usan `md menu` y `md launcher`).
//
// Hereda directamente de `Window` (no de `MdWindow`) para exponer setters de
// `accent`/tamaño/título en la API generada: Slint no re-expone como setters
// las propiedades heredadas de una base.
//
// El filtrado y el orden lo hace el anfitrión (Rust) con `md_core::menu`; este
// widget solo pinta la lista ya filtrada (`shown`) y emite callbacks.
export component MdMenu inherits Window {
    in property <color> accent: #7ec7a2;
    in property <length> md-radius: 10px;
    in-out property <string> md-title: "MinimalistDots";
    in-out property <length> md-width: 600px;
    in-out property <length> md-height: 400px;

    title <=> root.md-title;
    width <=> root.md-width;
    height <=> root.md-height;
    background: #1e222a;

    // ----- configuración (la fija el anfitrión) -----
    in property <string> prompt: "";
    in property <length> row-height: 40px;
    in property <bool> can-delete: false;
    in property <bool> can-wipe: false;
    in property <string> wipe-label: "🧹 Borrar todo";
    in property <string> confirm-wipe-label: "¿Seguro? Pulsa otra vez";
    // Si es `true`, Enter con la lista vacía emite `activated(-1)` (usar el
    // texto tecleado); en caso contrario no hace nada.
    in property <bool> submit-empty: false;

    // ----- datos -----
    in property <[MenuItem]> shown;
    in-out property <string> query;

    // ----- selección (el anfitrión la resetea a 0 al re-filtrar) -----
    in-out property <int> current-index: 0;

    // ----- callbacks hacia el anfitrión -----
    callback query-changed(string);
    callback activated(int);
    callback cancelled();
    callback delete-requested(int);
    callback wipe-requested();

    // Confirmación del borrado total (dos pulsaciones en 3 s).
    property <bool> confirm-wipe: false;

    // ---------- funciones de navegación ----------
    function clamp-index(index: int) -> int {
        if (shown.length == 0) {
            return 0;
        }
        return index.clamp(0, shown.length - 1);
    }

    function move-selection(delta: int) {
        current-index = clamp-index(current-index + delta);
        scroll-to-current();
    }

    function scroll-to-current() {
        let item-y = current-index * row-height;
        if (item-y < -list.content-y) {
            list.content-y = -item-y;
        } else if (item-y + row-height > -list.content-y + list.height) {
            list.content-y = -(item-y + row-height - list.height);
        }
    }

    function activate-current() {
        if (shown.length == 0) {
            if (submit-empty) {
                activated(-1);
            }
        } else {
            activated(current-index);
        }
    }

    function delete-current() {
        if (shown.length > 0) {
            delete-requested(current-index);
        }
    }

    function request-wipe() {
        if (confirm-wipe) {
            confirm-wipe = false;
            wipe-timer.stop();
            wipe-requested();
        } else {
            confirm-wipe = true;
            wipe-timer.start();
        }
    }

    wipe-timer := Timer {
        interval: 3s;
        running: false;
        triggered => {
            root.confirm-wipe = false;
            self.running = false;
        }
    }

    forward-focus: input;

    // ---------- barra de búsqueda ----------
    input-box := Rectangle {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        height: 40px;
        background: #282c34;
        border-radius: 6px;
    }

    prompt := Text {
        x: input-box.x + 10px;
        y: input-box.y;
        height: input-box.height;
        vertical-alignment: center;
        text: root.prompt;
        color: root.accent;
        font-weight: 600;
        visible: root.prompt != "";
    }

    wipe-btn := Rectangle {
        x: input-box.x + input-box.width - 116px;
        y: input-box.y + 6px;
        width: 106px;
        height: 28px;
        border-radius: 4px;
        visible: root.can-wipe;
        background: root.confirm-wipe ? #e06c75 : (wipe-area.has-hover ? #3e4451 : #00000000);

        Text {
            text: root.confirm-wipe ? root.confirm-wipe-label : root.wipe-label;
            color: root.confirm-wipe ? #1e222a : #abb2bf;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: center;
            width: 100%;
        }

        wipe-area := TouchArea {
            clicked => { root.request-wipe(); }
        }
    }

    input := TextInput {
        x: prompt.visible ? prompt.x + prompt.width + 8px : input-box.x + 10px;
        y: input-box.y;
        height: input-box.height;
        width: (wipe-btn.visible ? wipe-btn.x : input-box.x + input-box.width - 10px) - self.x;
        text <=> root.query;
        color: #abb2bf;
        vertical-alignment: center;
        single-line: true;

        edited => {
            root.query-changed(self.text);
        }

        key-pressed(event) => {
            let ctrl = event.modifiers.control;
            let shift = event.modifiers.shift;
            let key = event.text;
            if (key == Key.Escape) {
                root.cancelled();
                return accept;
            }
            if (key == Key.UpArrow || (ctrl && (key == "k" || key == "K" || key == "p" || key == "P"))) {
                root.move-selection(-1);
                return accept;
            }
            if (key == Key.DownArrow || (ctrl && (key == "j" || key == "J" || key == "n" || key == "N"))) {
                root.move-selection(1);
                return accept;
            }
            if (key == Key.Return) {
                root.activate-current();
                return accept;
            }
            if (root.can-wipe && ctrl && shift && key == Key.Delete) {
                root.request-wipe();
                return accept;
            }
            if (root.can-delete && ((shift && key == Key.Delete) || (ctrl && (key == "d" || key == "D")))) {
                root.delete-current();
                return accept;
            }
            return reject;
        }
    }

    // ---------- lista ----------
    list := Flickable {
        x: 10px;
        y: 54px;
        width: parent.width - 20px;
        height: parent.height - 64px;
        content-height: root.shown.length * root.row-height;

        for item[index] in root.shown : Rectangle {
            // selección por hover y activación por clic (capa inferior)
            row-area := TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.move) {
                        root.current-index = index;
                    }
                }
                clicked => { root.activated(index); }
            }

            y: index * root.row-height;
            width: parent.width;
            height: root.row-height;
            border-radius: 4px;
            background: index == root.current-index ? #3e4451 : #00000000;

            // icono (solo si la imagen no está vacía)
            if (item.icon.width > 0) : Image {
                x: 6px;
                y: (parent.height - self.height) / 2;
                width: root.row-height - 8px;
                height: root.row-height - 8px;
                source: item.icon;
                image-fit: contain;
            }

            // etiqueta
            Text {
                x: item.icon.width > 0 ? root.row-height + 2px : 8px;
                y: 0px;
                height: parent.height;
                width: parent.width - (item.icon.width > 0 ? root.row-height + 2px : 8px) - (root.can-delete ? 40px : 8px);
                vertical-alignment: center;
                text: item.label;
                color: index == root.current-index ? root.accent : #abb2bf;
                font-weight: index == root.current-index ? 600 : 400;
                overflow: elide;
            }

            // botón de borrar esta fila (solo en la fila seleccionada)
            if (root.can-delete && index == root.current-index) : Rectangle {
                x: parent.width - 34px;
                y: (parent.height - 22px) / 2;
                width: 26px;
                height: 22px;
                border-radius: 4px;
                background: #00000000;

                Text {
                    text: "🗑";
                    color: #abb2bf;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    width: 100%;
                }

                del-area := TouchArea {
                    clicked => { root.delete-requested(index); }
                }
            }
        }
    }
}

// OSD transitorio (volumen, brillo, etc.): una tarjeta pequeña que se muestra
// un instante y se cierra sola. El auto-cierre lo dispara el anfitrión con
// `slint::Timer`; este widget solo pinta icono + etiqueta + barra opcional.
export component MdOsd inherits Window {
    in property <color> accent: #7ec7a2;
    in property <color> card-color: #1e222a;
    in property <length> md-radius: 10px;
    in-out property <string> md-title: "md.osd";
    in-out property <length> md-width: 220px;
    in-out property <length> md-height: 56px;

    title <=> root.md-title;
    width <=> root.md-width;
    height <=> root.md-height;
    background: #00000000;

    // ----- datos -----
    in property <string> glyph: "";
    in property <string> label: "";
    // `-1` oculta la barra de progreso.
    in property <int> level: -1;
    in property <bool> muted: false;

    card := Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.card-color;
        border-radius: root.md-radius;
        border-width: 1px;
        border-color: root.muted ? #e06c75 : #00000000;
    }

    if (root.glyph != "") : Text {
        x: 14px;
        y: 0px;
        width: 24px;
        height: parent.height;
        text: root.glyph;
        color: root.accent;
        font-size: 18px;
        vertical-alignment: center;
    }

    Text {
        x: root.glyph != "" ? 42px : 14px;
        y: 0px;
        width: parent.width - (root.glyph != "" ? 42px : 14px) - 14px;
        height: parent.height;
        text: root.label;
        color: root.muted ? #e06c75 : #abb2bf;
        font-weight: 600;
        font-size: 14px;
        vertical-alignment: center;
    }

    if (root.level >= 0) : Rectangle {
        x: 14px;
        y: parent.height - 6px;
        width: parent.width - 28px;
        height: 3px;
        background: #3e4451;
        border-radius: 1px;

        Rectangle {
            width: parent.width * root.level / 100;
            height: 100%;
            background: root.accent;
            border-radius: 1px;
        }
    }
}

// Una tarjeta de notificación (proyección de una entrada del demonio).
export struct NotificationItem {
    app: string,
    summary: string,
    body: string,
    // "low" | "normal" | "critical" (cadena para no acoplar el .slint al enum Rust).
    urgency: string,
    // -1 oculta la barra de progreso; 0..100 pinta el nivel.
    progress: int,
}

// Pila de notificaciones (arriba a la derecha). El demonio (Rust) rellena el
// modelo y ajusta el alto de la ventana al contenido; este widget solo pinta las
// tarjetas y emite `close-requested` al hacer clic (o en la ✕).
//
// v1: el clic en la tarjeta cierra la notificación (la acción por defecto se
// añadirá cuando se implemente la invocación de acciones en el demonio).
export component MdNotifications inherits Window {
    in property <color> accent: #7aa2f7;
    in property <length> md-radius: 10px;
    in-out property <string> md-title: "md.notifications";
    in-out property <length> md-width: 420px;
    in-out property <length> md-height: 76px;

    title <=> root.md-title;
    width <=> root.md-width;
    height <=> root.md-height;
    background: #00000000;

    // ----- datos -----
    in property <[NotificationItem]> notifications;

    // ----- callbacks hacia el anfitrión -----
    callback close-requested(int);

    VerticalLayout {
        spacing: 8px;

        for item[index] in root.notifications : Rectangle {
            width: parent.width;
            height: 72px;
            background: #1e222a;
            border-radius: root.md-radius;
            border-width: 0px;

            // clic en la tarjeta = cerrar (v1); se declara primero para que la ✕
            // (más tarde en el z-order) gane en su zona.
            card-area := TouchArea {
                clicked => { root.close-requested(index); }
            }

            // nombre de la app (mayúsculas, pequeño)
            Text {
                x: 14px;
                y: 10px;
                height: 14px;
                width: parent.width - 60px;
                text: item.app;
                color: item.urgency == "critical" ? #e06c75 : #5c6370;
                font-size: 10px;
                font-weight: 600;
                overflow: elide;
            }

            // botón de cerrar
            close-btn := Rectangle {
                x: parent.width - 32px;
                y: 6px;
                width: 22px;
                height: 22px;
                border-radius: 4px;
                background: close-area.has-hover ? #3e4451 : #00000000;

                Text {
                    text: "✕";
                    color: #abb2bf;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                close-area := TouchArea {
                    clicked => { root.close-requested(index); }
                }
            }

            // resumen (negrita)
            Text {
                x: 14px;
                y: 26px;
                height: 18px;
                width: parent.width - 28px;
                text: item.summary;
                color: #abb2bf;
                font-size: 13px;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }

            // cuerpo
            Text {
                x: 14px;
                y: 46px;
                height: 14px;
                width: parent.width - 28px;
                text: item.body;
                color: #5c6370;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
                visible: item.body != "";
            }

            // barra de progreso (hint "value")
            if (item.progress >= 0) : Rectangle {
                x: 14px;
                y: 50px;
                width: parent.width - 28px;
                height: 3px;
                background: #3e4451;
                border-radius: 1px;

                Rectangle {
                    width: parent.width * item.progress / 100;
                    height: 100%;
                    background: item.urgency == "critical" ? #e06c75 : root.accent;
                    border-radius: 1px;
                }
            }
        }
    }
}

// Temporizador Pomodoro (reemplaza a `pomodoro.qml`).
//
// En concentración es una tarjeta pequeña; en descanso crece a una tarjeta
// grande (salvo que se minimice). El temporizador y las fases los lleva el
// anfitrión (Rust, con `md_core::Pomodoro`); este widget solo pinta el estado
// (`clock-text`, `session-text`, `subtitle`, `paused`, `big-break`, `pct`) y
// emite los botones (`pause`/`restart`/`stop`/`collapse`).
export component MdPomodoro inherits Window {
    in property <color> accent: #e06c75;
    in property <length> md-radius: 10px;
    in-out property <string> md-title: "md.pomodoro";
    in-out property <length> md-width: 190px;
    in-out property <length> md-height: 96px;

    title <=> root.md-title;
    width <=> root.md-width;
    height <=> root.md-height;
    background: #00000000;

    // ----- datos (los fija el anfitrión) -----
    in property <string> clock-text: "25:00";
    in property <string> session-text: "1/4";
    in property <string> subtitle: "";
    in property <bool> paused: false;
    in property <bool> big-break: false;
    in property <int> pct: 100;

    // ----- callbacks hacia el anfitrión -----
    callback pause-requested();
    callback restart-requested();
    callback stop-requested();
    callback collapse-requested();

    // ---------- tarjeta pequeña (concentración o descanso minimizado) ----------
    if (!root.big-break) : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #1e222a;
        border-radius: root.md-radius;
        border-width: 1px;
        border-color: #4b5263;

        VerticalLayout {
            padding: 10px;
            spacing: 4px;

            Text {
                text: root.clock-text;
                color: root.paused ? #5c6370 : #abb2bf;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: root.session-text;
                color: #5c6370;
                font-size: 10px;
                horizontal-alignment: center;
            }

            // barra fina: se vacía a medida que pasa el tiempo
            Rectangle {
                width: 100%;
                height: 3px;
                background: #3e4451;
                border-radius: 1px;

                Rectangle {
                    width: parent.width * root.pct / 100;
                    height: 100%;
                    background: root.accent;
                    border-radius: 1px;
                }
            }

            // botones: pausa / reiniciar / detener
            HorizontalLayout {
                alignment: center;
                spacing: 6px;

                pause-btn := Rectangle {
                    width: 28px;
                    height: 22px;
                    border-radius: 4px;
                    background: pause-area.has-hover ? #3e4451 : #00000000;

                    Text {
                        text: root.paused ? "▶" : "❚❚";
                        color: #abb2bf;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    pause-area := TouchArea {
                        clicked => { root.pause-requested(); }
                    }
                }

                restart-btn := Rectangle {
                    width: 28px;
                    height: 22px;
                    border-radius: 4px;
                    background: restart-area.has-hover ? #3e4451 : #00000000;

                    Text {
                        text: "↻";
                        color: #abb2bf;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    restart-area := TouchArea {
                        clicked => { root.restart-requested(); }
                    }
                }

                stop-btn := Rectangle {
                    width: 28px;
                    height: 22px;
                    border-radius: 4px;
                    background: stop-area.has-hover ? #3e4451 : #00000000;

                    Text {
                        text: "✕";
                        color: #abb2bf;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    stop-area := TouchArea {
                        clicked => { root.stop-requested(); }
                    }
                }
            }
        }
    }

    // ---------- tarjeta grande (descanso) ----------
    if (root.big-break) : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #1e222a;
        border-radius: 22px;
        border-width: 2px;
        border-color: root.paused ? #5c6370 : root.accent;

        VerticalLayout {
            padding: 24px;
            spacing: 10px;

            Text {
                text: root.paused ? "⏸  En pausa" : "☕  Hora de descansar";
                color: root.paused ? #5c6370 : root.accent;
                font-size: 24px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: root.clock-text;
                color: #abb2bf;
                font-size: 72px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: root.subtitle;
                color: #5c6370;
                font-size: 14px;
                horizontal-alignment: center;
            }

            Text {
                text: "Levántate, estírate y mira a lo lejos.";
                color: #5c6370;
                font-size: 13px;
                horizontal-alignment: center;
            }

            Rectangle {
                width: 100%;
                height: 6px;
                background: #3e4451;
                border-radius: 3px;

                Rectangle {
                    width: parent.width * root.pct / 100;
                    height: 100%;
                    background: root.accent;
                    border-radius: 3px;
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                bp := Rectangle {
                    width: 104px;
                    height: 30px;
                    border-radius: 8px;
                    background: bp-area.has-hover ? #3e4451 : #282c34;

                    Text {
                        text: root.paused ? "▶ Reanudar" : "❚❚ Pausar";
                        color: #abb2bf;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    bp-area := TouchArea {
                        clicked => { root.pause-requested(); }
                    }
                }

                br := Rectangle {
                    width: 104px;
                    height: 30px;
                    border-radius: 8px;
                    background: br-area.has-hover ? #3e4451 : #282c34;

                    Text {
                        text: "↻ Reiniciar";
                        color: #abb2bf;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    br-area := TouchArea {
                        clicked => { root.restart-requested(); }
                    }
                }

                bc := Rectangle {
                    width: 104px;
                    height: 30px;
                    border-radius: 8px;
                    background: bc-area.has-hover ? #3e4451 : #282c34;

                    Text {
                        text: "▾ Minimizar";
                        color: #abb2bf;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    bc-area := TouchArea {
                        clicked => { root.collapse-requested(); }
                    }
                }

                bs := Rectangle {
                    width: 104px;
                    height: 30px;
                    border-radius: 8px;
                    background: bs-area.has-hover ? #3e4451 : #282c34;

                    Text {
                        text: "✕ Detener";
                        color: #abb2bf;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    bs-area := TouchArea {
                        clicked => { root.stop-requested(); }
                    }
                }
            }
        }
    }
}

// Reloj de escritorio persistente (reemplaza a `clock.qml`).
//
// Muestra la hora (`HH:MM`) y la fecha (`"dom, 15 nov"`), actualizadas por el
// anfitrión con un temporizador de 1 s (solo pinta cuando cambia el minuto). La
// ventana es transparente; la posicionan las windowrules de Hyprland.
export component MdClock inherits Window {
    in property <length> md-radius: 10px;
    in-out property <string> md-title: "md.clock";
    in-out property <length> md-width: 280px;
    in-out property <length> md-height: 120px;

    title <=> root.md-title;
    width <=> root.md-width;
    height <=> root.md-height;
    background: #00000000;

    // ----- datos (los fija el anfitrión) -----
    in property <string> clock-text: "00:00";
    in property <string> date-text: "";

    VerticalLayout {
        padding: 10px;
        spacing: 4px;

        Text {
            text: root.clock-text;
            color: #abb2bf;
            font-size: 56px;
            font-weight: 700;
            horizontal-alignment: right;
        }

        Text {
            text: root.date-text;
            color: #5c6370;
            font-size: 16px;
            font-weight: 500;
            horizontal-alignment: right;
        }
    }
}

import { ScrollView } from "std-widgets.slint";

// =============================================================================
// MdWelcome: pantalla de bienvenida con identidad visual
// =============================================================================
export component MdWelcome inherits Window {
    in property <string> md-title: "Bienvenido a MinimalistDots";
    in property <string> subtitle: "";
    in property <string> label-changelog: "Novedades";
    in property <string> label-language: "Idioma";
    in property <string> label-binds: "Atajos";
    in property <string> label-github: "GitHub";
    in property <string> label-toggle-on: "Bienvenida: ON";
    in property <string> label-toggle-off: "Bienvenida: OFF";
    in property <string> label-exit: "Salir";
    in property <[string]> changelog;
    in property <bool> bienvenida-on: true;

    title <=> root.md-title;
    width: 760px;
    height: 600px;
    background: #1e222a;

    callback language();
    callback binds();
    callback github();
    callback toggle();
    callback exit-app();

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        // --- Cabecera con identidad visual ---
        Text {
            text: "MinimalistDots_Rs";
            color: #7ec7a2;
            font-size: 32px;
            font-weight: 800;
            horizontal-alignment: center;
        }
        Text {
            text: root.subtitle;
            color: #abb2bf;
            font-size: 14px;
            horizontal-alignment: center;
        }

        // --- Novedades (scroll) ---
        Text {
            text: "📦 " + root.label-changelog;
            color: #7aa2f7;
            font-size: 16px;
            font-weight: 700;
        }
        ScrollView {
            height: 260px;
            VerticalLayout {
                spacing: 6px;
                for entry in root.changelog : Text {
                    text: entry;
                    color: #abb2bf;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }
        }

        // --- Opciones ---
        HorizontalLayout {
            spacing: 12px;
            alignment: center;

            Rectangle {
                width: 120px; height: 40px; border-radius: 8px;
                background: lang-area.has-hover ? #3e4451 : #2c313a;
                Text { text: "🌐 " + root.label-language; color: #abb2bf; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                lang-area := TouchArea { clicked => { root.language(); } }
            }
            Rectangle {
                width: 120px; height: 40px; border-radius: 8px;
                background: binds-area.has-hover ? #3e4451 : #2c313a;
                Text { text: "⌨️ " + root.label-binds; color: #abb2bf; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                binds-area := TouchArea { clicked => { root.binds(); } }
            }
            Rectangle {
                width: 120px; height: 40px; border-radius: 8px;
                background: gh-area.has-hover ? #3e4451 : #2c313a;
                Text { text: "🐙 " + root.label-github; color: #abb2bf; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                gh-area := TouchArea { clicked => { root.github(); } }
            }
            Rectangle {
                width: 140px; height: 40px; border-radius: 8px;
                background: toggle-area.has-hover ? #3e4451 : #2c313a;
                Text { text: root.bienvenida-on ? "🔁 " + root.label-toggle-on : "🔁 " + root.label-toggle-off; color: #abb2bf; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                toggle-area := TouchArea { clicked => { root.toggle(); } }
            }
            Rectangle {
                width: 100px; height: 40px; border-radius: 8px;
                background: exit-area.has-hover ? #3e4451 : #2c313a;
                Text { text: "🚪 " + root.label-exit; color: #abb2bf; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                exit-area := TouchArea { clicked => { root.exit-app(); } }
            }
        }
    }
}
